# Demo mode works without keys. Use live only after server-side keys are configured.
NEXT_PUBLIC_APP_MODE=demo

# AI synthesis (server only)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra

# Live market / analyst aggregate data (server only)
FMP_API_KEY=

# Optional options-chain provider
MASSIVE_API_KEY=

# Optional persistence
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# SEC asks API clients to identify themselves.
SEC_USER_AGENT=Equity Research Lab your-email@example.com
